// Cloudflare Workers static-assets deploy for the Apsakaleidja viewer.
// Assets-only Worker (no script): serves web/ at https://lawlab.<account>.workers.dev
// Deploy: npx wrangler deploy   (requires wrangler login or CLOUDFLARE_API_TOKEN)
{
  "name": "lawlab",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./web",
    "not_found_handling": "404-page"
  }
}

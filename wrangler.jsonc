// Cloudflare Workers deploy for the Apsakaleidja viewer: static assets from
// web/ plus a tiny router worker for pretty URLs (/bill/<uuid>, /metoodika).
// Deploy: npx wrangler deploy
{
  "name": "lawlab",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "html_handling": "none",
    // The router worker owns every route (incl. /bill/:id and the /en language
    // prefix); without this, the assets layer 404s unmatched paths before the
    // worker runs. The worker falls through to env.ASSETS for real files.
    "run_worker_first": true
  }
}

# Copy to .env and fill in. NEVER commit the real .env.
# NOTE: the previous build leaked these keys in source — rotate them.

# LLM access — "openrouter" (works now) or "anthropic" (set ANTHROPIC_API_KEY)
LAWLAB_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...
# LAWLAB_OR_MODEL=anthropic/claude-opus-4.5     # verified at runtime
# LAWLAB_ANTHROPIC_MODEL=claude-opus-4-5

# Self-consistency
# LAWLAB_SC_SAMPLES=5
# LAWLAB_SC_K=3
# LAWLAB_SC_TEMP=0.4

# Supabase
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=eyJ...            # read-only (RLS), used by the web app
SUPABASE_SERVICE_KEY=eyJ...         # write access, used by workers only
# SUPABASE_DB_POOLER_URL=postgresql://...  # session-pooler DSN used by python -m db.apply

# Ingestion controls
# LAWLAB_SOFFICE=/usr/bin/soffice      # LibreOffice binary path, only needed when not on PATH
# LAWLAB_MIN_SEEN=100                  # corpus-size sanity floor; unset means half the current bill count
# LAWLAB_RECHECK_BILLS=123,456         # force these bill numbers to re-download
